<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Crypto Orator | Forex & Crypto Trading Support</title>
<meta name="description" content="1-on-1 personal trading support and analysis for new Forex and Crypto traders.">
<script>document.documentElement.classList.add('js')</script>
<style>
:root{--b:#3ba3ff;--g:#19e6a1;--r:#fb7185;--t:#eaf3ff;--m:#9db4cc;color-scheme:dark}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font:400 16px/1.6 -apple-system,"SF Pro Display","Segoe UI",Inter,system-ui,sans-serif;color:var(--t);background:#04070d;overflow-x:hidden;min-height:100vh}
body:has(#pre:not(.done)){overflow:hidden}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--g);outline-offset:3px}
.bg{position:fixed;inset:0;z-index:-2;background:
linear-gradient(180deg,rgba(2,6,14,.5),rgba(3,8,18,.8)),
radial-gradient(60% 50% at 12% 8%,rgba(59,163,255,.3),transparent 60%),
radial-gradient(50% 50% at 92% 82%,rgba(25,230,161,.24),transparent 60%),
url(bg.jpg) center/cover no-repeat,#04070d}
/* Liquid glass */
.glass{position:relative;isolation:isolate;overflow:hidden;border-radius:26px;
background:linear-gradient(135deg,rgba(255,255,255,.13),rgba(255,255,255,.03));
-webkit-backdrop-filter:blur(20px) saturate(170%);backdrop-filter:blur(20px) saturate(170%);
border:1px solid rgba(255,255,255,.14);
box-shadow:inset 0 1px 0 rgba(255,255,255,.38),inset 0 -1px 0 rgba(255,255,255,.06),inset 0 0 24px rgba(120,200,255,.07),0 0 0 1px rgba(59,163,255,.12),0 12px 40px rgba(0,0,0,.45),0 0 34px rgba(59,163,255,.1);
transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s,border-color .4s}
.glass::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;
background:linear-gradient(135deg,rgba(255,255,255,.6),transparent 35%,transparent 65%,rgba(25,230,161,.55));
-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude}
.glass::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;transition:opacity .3s;z-index:3;
background:radial-gradient(240px circle at var(--mx,50%) var(--my,0%),rgba(255,255,255,.2),transparent 60%),linear-gradient(115deg,transparent 40%,rgba(255,255,255,.2) 50%,transparent 60%) -150% 0/250% 100% no-repeat}
.glass:hover::after{opacity:1;animation:shine 1.1s}
@keyframes shine{to{background-position:0 0,150% 0}}
.glass:hover{transform:translateY(-4px);border-color:rgba(25,230,161,.4);box-shadow:inset 0 1px 0 rgba(255,255,255,.5),inset 0 0 28px rgba(120,200,255,.1),0 0 0 1px rgba(25,230,161,.25),0 18px 50px rgba(0,0,0,.5),0 0 46px rgba(25,230,161,.22)}
.nolift:hover{transform:none}
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:999px;font-weight:600;cursor:pointer}
.btn svg{width:20px;height:20px;fill:currentColor}
.btn.p{background:linear-gradient(135deg,rgba(59,163,255,.5),rgba(25,230,161,.4));box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 0 30px rgba(25,230,161,.4),0 0 60px rgba(59,163,255,.25);animation:glow 3s ease-in-out infinite alternate}
@keyframes glow{to{box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 0 44px rgba(25,230,161,.6),0 0 80px rgba(59,163,255,.4)}}
/* Preloader */
#pre{position:fixed;inset:0;z-index:100;display:grid;place-items:center;background:radial-gradient(50% 45% at 30% 30%,rgba(59,163,255,.22),transparent 70%),radial-gradient(45% 45% at 75% 75%,rgba(25,230,161,.18),transparent 70%),#03060c;transition:opacity .9s,visibility .9s,transform .9s}
#pre.done{opacity:0;visibility:hidden;transform:scale(1.05)}
.pc{width:min(460px,90vw);padding:26px 28px;text-align:center}
#chart{width:100%;height:auto;overflow:visible}
.cd{transform-box:fill-box;transform-origin:50% 100%;filter:drop-shadow(0 0 6px currentColor);animation:grow .6s cubic-bezier(.2,.9,.3,1.3) var(--d) both,flick 1.3s ease-in-out calc(var(--d) + .8s) infinite alternate}
@keyframes grow{from{transform:scaleY(0);opacity:0}}
@keyframes flick{to{transform:scaleY(.8)}}
.tl{stroke-dasharray:1000;stroke-dashoffset:1000;animation:draw 2.6s .3s forwards;filter:drop-shadow(0 0 6px var(--b))}
@keyframes draw{to{stroke-dashoffset:0}}
.pt{margin-top:8px;font-weight:600;letter-spacing:.14em;color:#cfe8ff}
.bar{height:4px;border-radius:9px;background:rgba(255,255,255,.1);margin:14px 0 8px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--b),var(--g));box-shadow:0 0 14px var(--g)}
.pn{font-size:13px;color:var(--m)}
/* Top: header + ticker */
.top{position:fixed;top:max(12px,env(safe-area-inset-top));left:0;right:0;z-index:50;display:grid;gap:10px;justify-items:center;padding:0 14px}
header,.tick{width:min(1120px,100%)}
header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:10px 12px 10px 20px;border-radius:999px}
.brand{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:.02em}
.logo{width:26px;height:26px;color:var(--g);filter:drop-shadow(0 0 6px var(--g))}
nav{display:flex;gap:6px}
nav a{padding:8px 16px;border-radius:999px;color:var(--m);font-size:15px;transition:.25s}
nav a:hover{color:#fff;background:rgba(255,255,255,.1)}
.soc{display:flex;gap:8px}
.soc a{width:40px;height:40px;display:grid;place-items:center;border-radius:50%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);transition:.3s}
.soc a:hover{background:rgba(25,230,161,.18);box-shadow:0 0 18px rgba(25,230,161,.5);transform:translateY(-2px)}
.soc svg{width:18px;height:18px}
.tick{display:flex;align-items:center;border-radius:999px;height:44px}
.live{flex:none;display:flex;align-items:center;gap:8px;padding:0 16px;font-size:13px;color:var(--g);border-right:1px solid rgba(255,255,255,.12);height:100%}
.live::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--g);box-shadow:0 0 10px var(--g);animation:pulse 1.4s infinite}
.live.off{color:var(--r)}.live.off::before{background:var(--r);box-shadow:0 0 10px var(--r);animation:none}
@keyframes pulse{50%{opacity:.35}}
.mq{flex:1;overflow:hidden;-webkit-mask:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
.trk{display:flex;width:max-content;animation:mq 34s linear infinite}
.tick:hover .trk{animation-play-state:paused}
@keyframes mq{to{transform:translateX(-50%)}}
.ti{display:flex;align-items:center;gap:10px;padding:0 26px;white-space:nowrap;font-size:14px;font-variant-numeric:tabular-nums}
.ti b{color:#fff}.ti em{font-style:normal;color:var(--t)}.ti u{text-decoration:none;font-size:12px}
.up{color:var(--g)}.dn{color:var(--r)}
/* Content */
main,footer{width:min(1120px,92%);margin-inline:auto}
.hero{margin-top:clamp(170px,24vh,230px);padding:clamp(34px,6vw,72px);border-radius:36px}
.hero h1{font-size:clamp(2.3rem,6.4vw,4.9rem);line-height:1.04;letter-spacing:-.035em;font-weight:800;max-width:15ch;background:linear-gradient(95deg,#fff 10%,#a9d8ff 55%,var(--g));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{margin:22px 0 32px;max-width:56ch;font-size:clamp(1.02rem,2vw,1.2rem);color:#c6d7e8}
.acts{display:flex;flex-wrap:wrap;gap:14px}
.sec{margin-top:clamp(70px,10vw,120px)}
.sec h2{font-size:clamp(1.8rem,4vw,2.8rem);letter-spacing:-.025em;line-height:1.15}
.sec>p{margin:10px 0 30px;color:var(--m);max-width:58ch}
.grid{display:grid;grid-template-columns:repeat(6,1fr);gap:18px}
.card{grid-column:span 2;padding:26px}
.card:nth-child(n+4){grid-column:span 3}
.card svg{width:100%;max-width:150px;height:auto;margin-bottom:16px}
.card h3{font-size:1.2rem;margin-bottom:8px}
.card p{color:var(--m);font-size:.97rem}
.cta{margin-top:clamp(70px,10vw,120px);padding:clamp(30px,5vw,56px);text-align:center;border-radius:36px}
.cta h2{font-size:clamp(1.7rem,4vw,2.6rem);letter-spacing:-.025em;margin-bottom:10px}
.cta p{color:var(--m);margin:0 auto 26px;max-width:50ch}
.cta .acts{justify-content:center}
footer{margin-block:70px 100px;padding:26px 30px;border-radius:30px;display:grid;gap:16px}
.fr{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:14px}
footer small{color:var(--m);font-size:.8rem;line-height:1.6;display:block}
.fab{position:fixed;right:max(20px,env(safe-area-inset-right));bottom:max(20px,env(safe-area-inset-bottom));z-index:60;width:60px;height:60px;border-radius:50%;display:grid;place-items:center;color:#fff;overflow:visible;background:linear-gradient(135deg,rgba(59,163,255,.55),rgba(25,230,161,.4))}
.fab svg{width:28px;height:28px;fill:currentColor}
.fab span{position:absolute;inset:-1px;border-radius:50%;border:2px solid var(--g);animation:ring 2.2s ease-out infinite;pointer-events:none}
@keyframes ring{to{transform:scale(1.7);opacity:0}}
/* Labourer bots */
.js .asm{opacity:0}.js .asm.in{opacity:1}
.bot{position:fixed;left:0;top:0;width:40px;height:40px;z-index:90;pointer-events:none;filter:drop-shadow(0 0 8px rgba(25,230,161,.8))}
.bot svg{width:100%;height:100%;animation:bob .35s ease-in-out infinite alternate}
@keyframes bob{to{transform:translateY(-3px) rotate(4deg)}}
@media(max-width:820px){nav{display:none}.grid{grid-template-columns:1fr}.card,.card:nth-child(n+4){grid-column:auto}.live span{display:none}}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01s!important;animation-iteration-count:1!important}.trk{animation:none}}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<symbol id="tg" viewBox="0 0 24 24"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></symbol>
<symbol id="x" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></symbol>
<symbol id="ml" viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></symbol>
</defs></svg>

<div class="bg"></div>

<div id="pre" role="status" aria-label="Loading">
  <div class="glass pc">
    <svg id="chart" viewBox="0 0 360 170"></svg>
    <div class="pt">Crypto Orator</div>
    <div class="bar"><i></i></div>
    <div class="pn">Loading market view <span id="pct">0</span>%</div>
  </div>
</div>

<div class="top">
  <header class="glass asm nolift" data-d="r">
    <a class="brand" href="#home" aria-label="Crypto Orator home">
      <svg class="logo" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="9" width="4" height="9" rx="1"/><rect x="10" y="4" width="4" height="12" rx="1"/><rect x="17" y="7" width="4" height="8" rx="1"/></svg>
      Crypto Orator
    </a>
    <nav aria-label="Main"><a href="#home">Home</a><a href="#method">Methodology</a><a href="#contact">Contact</a></nav>
    <div class="soc">
      <a href="https://t.me/crypto_orator" target="_blank" rel="noopener" aria-label="Telegram"><svg fill="currentColor"><use href="#tg"/></svg></a>
      <a href="https://x.com/crypto_orator" target="_blank" rel="noopener" aria-label="X (Twitter)"><svg fill="currentColor"><use href="#x"/></svg></a>
      <a href="mailto:info@cryptoorator.com" aria-label="Email"><svg><use href="#ml"/></svg></a>
    </div>
  </header>
  <div class="glass asm nolift tick" data-d="l" title="Live prices from Binance. XAU/USD is tracked via PAXG, a gold-backed token.">
    <div class="live"><span>Live</span></div>
    <div class="mq"><div class="trk"></div></div>
  </div>
</div>

<main>
  <section id="home" class="glass asm hero" data-d="u">
    <h1>Trade with a plan, and someone in your corner.</h1>
    <p>Personal 1-on-1 trading support and market analysis for new traders. Message me directly on Telegram and we will work through your charts, your risk and your next trade together.</p>
    <div class="acts">
      <a class="glass btn p" href="https://t.me/crypto_orator" target="_blank" rel="noopener"><svg><use href="#tg"/></svg>Message me on Telegram</a>
      <a class="glass btn" href="#method">See how I read the market</a>
    </div>
  </section>

  <section id="method" class="sec">
    <h2>Core trading concepts</h2>
    <p>The five tools behind every chart I analyse, taught step by step.</p>
    <div class="grid">
      <article class="glass asm card" data-d="r">
        <svg viewBox="0 0 120 56" aria-hidden="true"><path d="M0 12h120M0 44h120" stroke="#3ba3ff" stroke-dasharray="4 4"/><path d="M4 40l18-22 16 20 18-24 16 22 18-18 20 8" fill="none" stroke="#19e6a1" stroke-width="2"/></svg>
        <h3>Support & Resistance</h3>
        <p>Price levels where buyers or sellers have repeatedly stepped in. I map them on higher timeframes to decide where a trade makes sense and where it is wrong.</p>
      </article>
      <article class="glass asm card" data-d="u">
        <svg viewBox="0 0 120 56" aria-hidden="true"><rect x="38" y="20" width="44" height="18" fill="#3ba3ff" opacity=".3" stroke="#3ba3ff"/><path d="M6 40l22-4 14 6 22-24 26-8 24-4" fill="none" stroke="#19e6a1" stroke-width="2"/></svg>
        <h3>Order Block (OB)</h3>
        <p>The last opposing candle before a strong impulsive move. When price returns to it, it often reacts, giving a precise area to plan an entry.</p>
      </article>
      <article class="glass asm card" data-d="l">
        <svg viewBox="0 0 120 56" aria-hidden="true"><rect y="6" width="120" height="14" fill="#fb7185" opacity=".25"/><rect y="38" width="120" height="14" fill="#19e6a1" opacity=".25"/><path d="M6 44l24-28 24 28 24-28 24 28" fill="none" stroke="#fff" opacity=".7" stroke-width="2"/></svg>
        <h3>Supply & Demand Zones</h3>
        <p>Areas where price left sharply because orders outweighed the other side. Fresh, untested zones are where I look for the strongest reactions.</p>
      </article>
      <article class="glass asm card" data-d="r">
        <svg viewBox="0 0 120 56" aria-hidden="true"><rect x="38" y="22" width="44" height="12" fill="#3ba3ff" opacity=".4"/><rect x="18" y="26" width="12" height="22" rx="2" fill="#19e6a1"/><rect x="54" y="8" width="12" height="38" rx="2" fill="#19e6a1"/><rect x="90" y="4" width="12" height="18" rx="2" fill="#19e6a1"/></svg>
        <h3>Fair Value Gap (FVG)</h3>
        <p>A three-candle imbalance that leaves a gap in price. Markets often come back to fill it, which helps refine entries and place tighter stops.</p>
      </article>
      <article class="glass asm card" data-d="l">
        <svg viewBox="0 0 120 56" aria-hidden="true"><rect y="20" width="120" height="14" fill="#19e6a1" opacity=".25"/><path d="M0 6h120M0 20h120M0 34h120M0 50h120" stroke="#fff" opacity=".35"/><path d="M6 6l30 40 20-16 24 16 30-30" fill="none" stroke="#3ba3ff" stroke-width="2"/></svg>
        <h3>Golden Zone (Fibonacci)</h3>
        <p>The retracement area around the 0.618 Fibonacci level, where pullbacks often stall. It works best when it lines up with the other four concepts.</p>
      </article>
    </div>
  </section>

  <section id="contact" class="glass asm cta" data-d="u">
    <h2>Ready to make your first plan?</h2>
    <p>Tell me where you are in your trading and what you want to learn. I reply personally on Telegram.</p>
    <div class="acts">
      <a class="glass btn p" href="https://t.me/crypto_orator" target="_blank" rel="noopener"><svg><use href="#tg"/></svg>Start a chat on Telegram</a>
      <a class="glass btn" href="mailto:info@cryptoorator.com"><svg style="fill:none;stroke:currentColor"><use href="#ml"/></svg>info@cryptoorator.com</a>
    </div>
  </section>
</main>

<footer class="glass asm" data-d="u">
  <div class="fr">
    <a class="brand" href="#home">© 2026 Crypto Orator</a>
    <div class="soc">
      <a href="https://t.me/crypto_orator" target="_blank" rel="noopener" aria-label="Telegram"><svg fill="currentColor"><use href="#tg"/></svg></a>
      <a href="https://x.com/crypto_orator" target="_blank" rel="noopener" aria-label="X (Twitter)"><svg fill="currentColor"><use href="#x"/></svg></a>
      <a href="mailto:info@cryptoorator.com" aria-label="Email"><svg><use href="#ml"/></svg></a>
    </div>
  </div>
  <small><strong>Risk disclaimer:</strong> Trading forex, cryptocurrencies and leveraged products carries a high level of risk and may not be suitable for everyone. You can lose some or all of your capital. Everything on this site is for education only and is not financial advice. Past performance does not guarantee future results. Only trade with money you can afford to lose.</small>
</footer>

<a class="glass fab nolift" href="https://t.me/crypto_orator" target="_blank" rel="noopener" aria-label="Chat on Telegram"><span></span><svg><use href="#tg"/></svg></a>

<script>
try{(()=>{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const rm=matchMedia('(prefers-reduced-motion:reduce)').matches;

/* Preloader candlestick chart */
let y=125,h='',pts=[];
for(let i=0;i<18;i++){
  const o=y,c=Math.max(30,Math.min(145,o+(Math.random()-.62)*28)),hi=Math.min(o,c)-3-Math.random()*10,lo=Math.max(o,c)+3+Math.random()*10,x=18+i*19.5,up=c<=o,col=up?'#19e6a1':'#fb7185';
  h+=`<g class="cd" style="color:${col};--d:${(i*.12).toFixed(2)}s"><line x1="${x}" x2="${x}" y1="${hi}" y2="${lo}" stroke="currentColor" stroke-width="1.6"/><rect x="${x-6}" y="${Math.min(o,c)}" width="12" height="${Math.max(3,Math.abs(c-o))}" rx="2.5" fill="currentColor"/></g>`;
  pts.push(x+','+c);y=c;
}
$('#chart').innerHTML=h+`<polyline class="tl" pathLength="1000" points="${pts.join(' ')}" fill="none" stroke="#3ba3ff" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>`;

const D=rm?200:2900,t0=performance.now();
const anim=new Promise(res=>{(function f(t){const k=Math.min(1,(t-t0)/D);$('#pct').textContent=Math.round(k*100);$('.bar i').style.width=k*100+'%';k<1?requestAnimationFrame(f):res()})(t0)});
const loaded=new Promise(r=>document.readyState==='complete'?r():addEventListener('load',r));
Promise.all([anim,loaded]).then(()=>{$('#pre').classList.add('done');setTimeout(build,rm?0:650)});

/* Labourer bots */
const BOT='<svg viewBox="0 0 40 40"><path d="M20 9V4" stroke="#3ba3ff" stroke-width="2"/><circle cx="20" cy="3.5" r="2.6" fill="#19e6a1"/><rect x="6" y="9" width="28" height="21" rx="8" fill="#0a1424" stroke="#3ba3ff" stroke-width="1.6"/><circle cx="14.5" cy="19" r="3.2" fill="#19e6a1"/><circle cx="25.5" cy="19" r="3.2" fill="#19e6a1"/><rect x="11" y="32" width="18" height="5" rx="2.5" fill="#3ba3ff" opacity=".75"/></svg>';
const V={r:[1,0],l:[-1,0],u:[0,-1],d:[0,1]},E='cubic-bezier(.22,.9,.28,1)';
function assemble(el){
  if(rm){el.classList.add('in');return}
  const d=el.dataset.d||'u',r=el.getBoundingClientRect(),[x,y]=V[d],W=innerWidth,H=innerHeight;
  const ox=-x*Math.min(W*.6,520),oy=-y*170,cx=r.left+r.width/2,cy=r.top+r.height/2;
  const bx=cx-x*(r.width/2+30)-20,by=cy-y*(r.height/2+30)-20;
  const T=(a,b)=>`translate(${a}px,${b}px)`,side=Math.random()<.5?-90:W+90;
  const b=document.createElement('div');b.className='bot';b.innerHTML=BOT;document.body.append(b);
  b.animate([
    {transform:T(side,Math.random()*H),opacity:0},
    {transform:T(bx+ox,by+oy),opacity:1,offset:.3,easing:E},
    {transform:T(bx,by),opacity:1,offset:.8},
    {transform:T(side,by-60),opacity:0}
  ],{duration:2000,easing:'ease-in-out'}).onfinish=()=>b.remove();
  const a=el.animate([{transform:`translate(${ox}px,${oy}px) scale(.96)`,opacity:0},{transform:'none',opacity:1}],{duration:1000,delay:600,easing:E,fill:'both'});
  a.onfinish=()=>{el.classList.add('in');a.cancel()};
}
let free=0;
function queue(el){const n=performance.now(),at=Math.max(n,free);free=at+420;setTimeout(()=>assemble(el),at-n)}
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){io.unobserve(e.target);queue(e.target)}}),{threshold:.15});
function build(){
  const first=['header','.tick','.hero'].map(s=>$(s));
  first.forEach(queue);
  $$('.asm').filter(e=>!first.includes(e)).forEach(e=>io.observe(e));
}

/* Liquid glass specular follow */
addEventListener('pointermove',e=>{const g=e.target.closest&&e.target.closest('.glass');if(g){const r=g.getBoundingClientRect();g.style.setProperty('--mx',e.clientX-r.left+'px');g.style.setProperty('--my',e.clientY-r.top+'px')}});

/* Live prices (Binance public API; XAU/USD via PAXG gold token) */
const S=[['BTC','BTCUSDT','BTC/USD'],['ETH','ETHUSDT','ETH/USD'],['XAU','PAXGUSDT','XAU/USD']];
const item=s=>`<span class="ti"><b>${s[2]}</b><em data-p="${s[0]}">…</em><u data-c="${s[0]}"></u></span>`;
$('.trk').innerHTML=S.map(item).join('').repeat(4);
const fmt=n=>'$'+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
async function tick(){
  try{
    const r=await fetch('https://api.binance.com/api/v3/ticker/24hr?symbols='+encodeURIComponent(JSON.stringify(S.map(s=>s[1]))));
    if(!r.ok)throw 0;
    (await r.json()).forEach(q=>{
      const n=S.find(s=>s[1]===q.symbol)[0],p=+q.lastPrice,c=+q.priceChangePercent;
      $$(`[data-p=${n}]`).forEach(e=>e.textContent=fmt(p));
      $$(`[data-c=${n}]`).forEach(e=>{e.textContent=(c>=0?'▲ ':'▼ ')+Math.abs(c).toFixed(2)+'%';e.className=c>=0?'up':'dn'});
    });
    $('.live').classList.remove('off');
  }catch(e){$('.live').classList.add('off');$$('[data-p]').forEach(e=>{if(e.textContent==='…')e.textContent='unavailable'})}
}
tick();setInterval(tick,5000);
})()}catch(err){console.error(err);document.documentElement.classList.remove('js');const p=document.getElementById('pre');p&&p.remove()}
</script>
</body>
</html>
